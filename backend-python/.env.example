# Copy this file to backend-python/.env and fill in your own values.
# .env is git-ignored; this template is not.

# Free key: https://www.eia.gov/opendata/register.php
# Required for live ethanol production + stocks. Without it, the dashboard
# shows synthetic seed data for those two series and the orange banner stays up.
APP_EIA_API_KEY=

# Any random string. Only needed if you call POST /api/admin/ingest.
APP_ADMIN_TOKEN=

# IBM watsonx.ai — required for the Granite signal briefing strip.
# API key from https://cloud.ibm.com/iam/apikeys
APP_WATSONX_API_KEY=
# Project ID from your watsonx.ai project settings
APP_WATSONX_PROJECT_ID=
# Regional endpoint (default: us-south)
APP_WATSONX_URL=https://us-south.ml.cloud.ibm.com
